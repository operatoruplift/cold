# COLD - environment. Copy to .env.local (Bun loads it automatically).
# Secrets live here; who sends and what you offer live in cold.yaml.

# Twenty CRM: every touch (email sent, DM sent, reply, opt-out) is written here.
# Cloud: https://api.twenty.com   Self-hosted: https://your-twenty-domain
# Create a key in Settings -> Developers -> API. Leave both empty to keep the
# touch log in .cold/touches.jsonl instead.
TWENTY_BASE_URL=
TWENTY_API_KEY=

# Mailboxes, one pair per account in cold.yaml (the names are set there).
# URL-encode special characters in the password (@ -> %40, : -> %3A).
# Gmail and Google Workspace need 2-Step Verification and an app password.
#   SMTP: smtps://you%40yourdomain.com:app-password@smtp.gmail.com:465
#   IMAP: imaps://you%40yourdomain.com:app-password@imap.gmail.com:993
SMTP_URL_PERSONAL=
IMAP_URL_PERSONAL=
SMTP_URL_COMPANY=
IMAP_URL_COMPANY=

# Optional: Reacher (open source email verification, self-hosted).
#   docker run -p 8080:8080 reacherhq/backend:latest
# With REACHER_URL set, step 1 of an email sequence is only sent to addresses
# Reacher does not call invalid.
REACHER_URL=
REACHER_SECRET=

# AI: Claude finds and researches prospects (with web search), personalizes
# drafts, prepares calls and reads replies. Nothing is sent without you.
# Create a key at https://console.anthropic.com (Settings, API keys).
ANTHROPIC_API_KEY=
# COLD_AI_MODEL=   (another Claude model id; the default is in src/domains/ai/claude.ts)

# Hosting (docs/deploy.md). These belong in the server's real environment,
# not in this file, since .env.local lives inside COLD_HOME.
# COLD_PUBLIC_URL=https://cold.example.com
# COLD_HOME=/data
# The login, set from the environment instead of the setup code:
# COLD_OWNER_EMAIL=you@example.com
# COLD_OWNER_PASSWORD_HASH=   (bun run cold owner hash)
