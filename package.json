{
  "name": "cold",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Cold call scripts, cold DMs and cold emails for personal and company accounts: open source, with a local web app and every touch kept in Twenty CRM.",
  "author": "Operator Uplift (https://github.com/operatoruplift)",
  "license": "MIT",
  "homepage": "https://github.com/operatoruplift/cold#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/operatoruplift/cold.git"
  },
  "bugs": {
    "url": "https://github.com/operatoruplift/cold/issues"
  },
  "keywords": [
    "cold-email",
    "cold-calling",
    "cold-dm",
    "outreach",
    "sales-scripts",
    "crm",
    "twenty",
    "twenty-crm",
    "nodemailer",
    "open-source"
  ],
  "bin": {
    "cold": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "cold": "bun src/cli.ts",
    "ui": "bun src/domains/web/server/index.ts",
    "start": "bun src/domains/web/server/index.ts --no-open",
    "dev": "bun --watch src/domains/web/server/index.ts --no-open",
    "desktop": "bun src/domains/web/server/index.ts --window",
    "build": "bun src/domains/web/server/build.ts",
    "lint:messages": "bun src/cli.ts lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run lint:messages",
    "twenty:schema": "bun src/cli.ts twenty:schema",
    "twenty:schema:check": "bun src/cli.ts twenty:schema --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource-variable/inter": "5.3.0",
    "imapflow": "2.5.2",
    "lucide-react": "1.55.0",
    "mailparser": "3.9.40",
    "nodemailer": "10.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/mailparser": "3.9.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "smtp-server": "3.19.23",
    "typescript": "7.0.2"
  }
}
